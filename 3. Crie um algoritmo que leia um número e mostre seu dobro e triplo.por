programa {
  funcao inicio() {
    inteiro numero, dobro, triplo 
    escreva("digite um número para saber o dobro e o triplo dele \n")
    leia (numero)
    dobro = numero *2
    escreva("O dobro do número é \n", dobro, "\n")
   triplo = numero *3
   escreva("O triplo do número é \n", triplo)

    
  }
}
