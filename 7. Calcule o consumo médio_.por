programa {
  funcao inicio() {
    real consumo, quilometros, litros
    escreva("Quantos quilômetros você percorreu? \n")
    leia(quilometros)
    escreva("Quantos litros de combustível foi utilizado? \n")
    leia(litros)
    consumo = quilometros/litros
    escreva("O consumo foi de ", consumo)
    
  }
}
