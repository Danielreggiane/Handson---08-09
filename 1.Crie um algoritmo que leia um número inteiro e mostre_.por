programa {
  funcao inicio() {
    inteiro antecessor, sucessor, numero 
    escreva("Digite um número para saber seu antecessor \n")
    leia (numero)
  antecessor = numero -1
   escreva("O antecessor é ", antecessor, "\n")
   escreva("Digite outro número para saber seu sucessor \n")
    leia (numero)
    sucessor= numero +1
     escreva("O sucessor é ", sucessor)
    
  }
}
