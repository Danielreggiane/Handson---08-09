programa {
  funcao inicio() {
    real numero1, numero2, soma, subtracao, divisao, multiplicacao
    escreva("Digite um número \n")
    leia(numero1)
    escreva("Digite outro número \n")
    leia(numero2)
    soma= numero1 + numero2
    escreva("A soma dos números è ", soma, "\n")
    subtracao = numero1 - numero2
     escreva("A subtração dos números è ", subtracao, "\n")
     divisao = numero1 / numero2
      escreva("A divisão dos números é ", divisao, "\n")
      multiplicacao = numero1 * numero2
       escreva("A multiplicação dos números è ", multiplicacao, "\n")


    
  }
}
