programa {
  funcao inicio() {
    logico a, b
    a = verdadeiro
    b = verdadeiro
    escreva("Quando a é: ", a, " | B: ", b, " | E: ", a e b, " | OU: ", a ou b, "\n")
    a = verdadeiro
    b = falso
    escreva("Quando a é: ", a, " | B: ", b, " | E: ", a e b, " | OU: ", a ou b, "\n")
    a = falso
    b = verdadeiro
    escreva("Quando a é: ", a, " | B: ", b, " | E: ", a e b, " | OU: ", a ou b, "\n")
    a = falso
    b = falso
    escreva("Quando a é: ", a, " | B: ", b, " | E: ", a e b, " | OU: ", a ou b, "\n")
    
  }
}
