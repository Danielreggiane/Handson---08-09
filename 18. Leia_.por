programa {
  funcao inicio() {
   cadeia nome, cidade
   inteiro idade
    escreva("Qual seu nome? ")
    leia(nome)
    escreva("Qual sua idade? ")
    leia(idade)
    escreva("Qual sua cidade? ")
    leia(cidade)
    escreva("Me chamo ", nome, " tenho ", idade, " anos ", "moro em ", cidade, ".")
  }
}
