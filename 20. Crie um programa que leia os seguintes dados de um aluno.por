programa {
  funcao inicio() {
    cadeia aluno
    inteiro idade
    real notafinal
    caracter sexo
    logico matriculado

    escreva("O aluno está matriculado? ")
    leia(matriculado)
    escreva("Qual o nome completo do aluno? ")
    leia(aluno)
    escreva("Qual a idade do aluno? ")
    leia(idade)
    escreva("Qual o sexo do aluno(a)? ")
    leia(sexo)
    escreva("Qual a nota do aluno? ")
    leia(notafinal)
    escreva("O ", aluno, " tem ", idade, " anos, é do sexo ", sexo, " e está matriculado? ", matriculado, "." )
    
  }
}
